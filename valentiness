<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Valentine's Day ❤️</title>

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

<style>
:root{
  --pink:#ff7aa2;
  --red:#e63946;
  --white:#ffffff;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:'Poppins', sans-serif;
  background:linear-gradient(135deg,#ffe0ec,#fff);
  color:#333;
  overflow-x:hidden;
}

/* HEART BACKGROUND */
.hearts{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  pointer-events:none;
  z-index:-1;
}

.heart{
  position:absolute;
  width:20px;
  height:20px;
  background:var(--pink);
  transform:rotate(45deg);
  animation:float 12s linear infinite;
  opacity:0.6;
}

.heart::before,
.heart::after{
  content:"";
  width:20px;
  height:20px;
  background:var(--pink);
  border-radius:50%;
  position:absolute;
}

.heart::before{ top:-10px; left:0; }
.heart::after{ left:-10px; top:0; }

@keyframes float{
  0%{transform:translateY(100vh) rotate(45deg);}
  100%{transform:translateY(-10vh) rotate(45deg);}
}

/* HERO */
.hero{
  min-height:100vh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:20px;
}

.hero h1{
  font-family:'Playfair Display', serif;
  font-size:3rem;
  color:var(--red);
}

.hero p{
  margin-top:15px;
  font-size:1.1rem;
  opacity:0;
  animation:fadeIn 2s forwards;
}

@keyframes fadeIn{
  to{opacity:1;}
}

.hero button{
  margin-top:30px;
  padding:14px 32px;
  font-size:1rem;
  background:var(--red);
  color:white;
  border:none;
  border-radius:30px;
  cursor:pointer;
  transition:.3s;
}

.hero button:hover{
  background:#c92d3a;
  transform:scale(1.05);
}

/* LOVE LETTER */
.letter-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.5);
  display:none;
  justify-content:center;
  align-items:center;
  z-index:10;
}

.letter{
  background:white;
  max-width:500px;
  padding:30px;
  border-radius:20px;
  animation:pop .5s ease;
}

@keyframes pop{
  from{transform:scale(.7); opacity:0;}
  to{transform:scale(1); opacity:1;}
}

.letter h2{
  font-family:'Playfair Display', serif;
  color:var(--red);
  margin-bottom:15px;
}

.close{
  text-align:right;
  cursor:pointer;
  color:var(--red);
  font-weight:bold;
}

/* COUNTDOWN */
.countdown{
  margin:40px 0;
  text-align:center;
}

.countdown h3{
  color:var(--red);
  margin-bottom:10px;
}

.timer{
  display:flex;
  justify-content:center;
  gap:15px;
}

.time-box{
  background:white;
  padding:15px 20px;
  border-radius:12px;
  min-width:70px;
}

/* GALLERY */
.gallery{
  padding:60px 20px;
  max-width:1100px;
  margin:auto;
}

.gallery h2{
  text-align:center;
  font-family:'Playfair Display', serif;
  color:var(--red);
  margin-bottom:30px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:15px;
}

.grid img{
  width:100%;
  border-radius:15px;
  cursor:pointer;
  transition:.3s;
}

.grid img:hover{
  transform:scale(1.05);
}

/* LIGHTBOX */
.lightbox{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.8);
  display:none;
  justify-content:center;
  align-items:center;
  z-index:20;
}

.lightbox img{
  max-width:90%;
  max-height:90%;
  border-radius:15px;
}

/* FOOTER */
footer{
  text-align:center;
  padding:25px;
  color:#555;
}

/* RESPONSIVE */
@media(max-width:600px){
  .hero h1{font-size:2.2rem;}
}
</style>
</head>
<body>

<div class="hearts" id="hearts"></div>

<!-- HERO -->
<section class="hero">
  <h1>Happy Valentine’s Day ❤️</h1>
  <p>Untuk seseorang yang selalu membuat hatiku berbunga.</p>
  <button onclick="openLetter()">💌 Open My Heart</button>
</section>

<!-- LOVE LETTER -->
<div class="letter-overlay" id="letter">
  <div class="letter">
    <div class="close" onclick="closeLetter()">✖</div>
    <h2>My Love 💖</h2>
    <p>
      [Tulis pesan cintamu di sini]<br><br>
      Terima kasih sudah hadir dalam hidupku dan membuat setiap hari terasa lebih indah.
      Semoga cinta ini selalu tumbuh dan tak pernah pudar. ❤️
    </p>
    <br>
    <audio id="music" controls loop>
      <source src="https://cdn.pixabay.com/audio/2023/02/14/audio_6d30fa0a3f.mp3" type="audio/mpeg">
    </audio>
  </div>
</div>

<!-- COUNTDOWN -->
<section class="countdown">
  <h3>Countdown to Valentine 💘</h3>
  <div class="timer" id="timer"></div>
</section>

<!-- GALLERY -->
<section class="gallery">
  <h2>Our Memories 📸</h2>
  <div class="grid">
    <img src="https://picsum.photos/400?1" onclick="openImg(this)">
    <img src="https://picsum.photos/400?2" onclick="openImg(this)">
    <img src="https://picsum.photos/400?3" onclick="openImg(this)">
    <img src="https://picsum.photos/400?4" onclick="openImg(this)">
  </div>
</section>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox" onclick="closeImg()">
  <img id="lightboxImg">
</div>

<footer>
  Made with love ❤️
</footer>

<script>
// HEARTS
for(let i=0;i<30;i++){
  const h=document.createElement("div");
  h.className="heart";
  h.style.left=Math.random()*100+"%";
  h.style.animationDuration=8+Math.random()*6+"s";
  h.style.opacity=Math.random();
  document.getElementById("hearts").appendChild(h);
}

// LETTER
function openLetter(){
  document.getElementById("letter").style.display="flex";
}
function closeLetter(){
  document.getElementById("letter").style.display="none";
}

// LIGHTBOX
function openImg(img){
  document.getElementById("lightbox").style.display="flex";
  document.getElementById("lightboxImg").src=img.src;
}
function closeImg(){
  document.getElementById("lightbox").style.display="none";
}

// COUNTDOWN
const target=new Date(new Date().getFullYear(),1,14);
const timer=document.getElementById("timer");

setInterval(()=>{
  const now=new Date();
  const diff=target-now;
  if(diff<0) return;
  const d=Math.floor(diff/86400000);
  const h=Math.floor(diff/3600000)%24;
  const m=Math.floor(diff/60000)%60;
  const s=Math.floor(diff/1000)%60;

  timer.innerHTML=`
    <div class="time-box">${d}<br>Days</div>
    <div class="time-box">${h}<br>Hours</div>
    <div class="time-box">${m}<br>Minutes</div>
    <div class="time-box">${s}<br>Seconds</div>
  `;
},1000);
</script>

</body>
</html>
